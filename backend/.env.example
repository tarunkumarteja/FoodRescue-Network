# ==============================================================================
# FoodRescueNetwork - Backend Environment Configuration Template
# Copy this file to .env and fill in your local development values.
# NEVER commit the actual .env file or real credentials to source control.
# ==============================================================================

# Django Core Settings
SECRET_KEY=replace-with-a-secure-secret-key-for-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=food_rescue_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# SimpleJWT Authentication Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
